PORT=4310
HOST=127.0.0.1
APP_URL=http://localhost:4310
# Set production only behind HTTPS, after completing README launch checks.
NODE_ENV=development
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# Hosted first-owner bootstrap only (enter secrets in hosting dashboard).
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DB_PATH=/app/data/portal.sqlite
# Render supplies RENDER_EXTERNAL_URL; set APP_URL only for a custom domain.

# Free Render + Supabase (server-only secret, NEVER in public JavaScript):
# DATABASE_URL=postgresql://... (Supabase Session pooler URI)
# REQUIRE_DATABASE_URL=true
# DATABASE_CA=optional PEM certificate if your endpoint requires a custom CA
